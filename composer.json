{
    "name": "radiustheme/radius-hotel-booking",
    "description": "WordPress plugin hotel booking with a DI container, ORM, migrations, REST router and WP-CLI scaffolding.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "RadiusTheme",
            "email": "support@radiustheme.com"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "RadiusTheme\\RadiusHotelBooking\\": "includes/"
        }
    },
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "scripts": {
        "phpcs": "./vendor/bin/phpcs --standard=phpcs.xml",
        "phpcs:fix": "./vendor/bin/phpcbf --standard=phpcs.xml",
        "phpcs:report": "./vendor/bin/phpcs --standard=phpcs.xml --report=csv > phpcs-report.csv"
    }
}

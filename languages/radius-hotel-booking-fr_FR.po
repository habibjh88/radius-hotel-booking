msgid "Adds a rooms field to the search bar, for guests booking for a group."
msgstr ""
"Ajoute un champ de chambres à la barre de recherche, pour les clients qui "
"réservent pour un groupe."

#: src/modules/Settings/sections/Website.jsx:433
msgid "Booking form"
msgstr "Formulaire de réservation"


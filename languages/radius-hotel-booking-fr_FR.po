#: src/modules/Settings/sections/Email.jsx:78
msgid "Use an address on your own domain, so e-mails are not marked as spam."
msgstr ""
"Utilisez une adresse de votre propre domaine, pour que les e-mails ne soient "
"pas classés comme spam."

#: src/modules/Settings/sections/Email.jsx:88
msgid "Reply-to e-mail"
msgstr "E-mail de réponse"

#: src/modules/Settings/sections/Email.jsx:89
